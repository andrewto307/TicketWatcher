# Secrets / local env — NEVER commit these
.env
.env.local
.env.*.local

# Keep the template
!.env.example

# Go
/bin/
/out/
*.exe
/ticket-watcher

# Node / frontend
node_modules/
web/node_modules/
# Ignore built SPA output, but keep the placeholder so `//go:embed dist` still
# compiles on a fresh checkout (before `npm run build` has run).
web/dist/*
!web/dist/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/

# Local Claude Code settings. Usually covered by a global gitignore, but that
# doesn't travel with the repo — and this file can contain API keys.
.claude/settings.local.json
