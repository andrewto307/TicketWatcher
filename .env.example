# Copy to .env and fill in your values. .env is gitignored; this template is not.

# Ticketmaster Discovery API — your "Consumer Key" from
# https://developer.ticketmaster.com/my-apps
TM_API_KEY=your_ticketmaster_consumer_key
TM_BASE_URL=https://app.ticketmaster.com/discovery/v2

# HTTP server
HTTP_ADDR=:8080

# PostgreSQL (used from Phase 2 onward; safe to leave as-is for Phase 1)
DATABASE_URL=postgres://watcher:watcher@localhost:5432/watcher?sslmode=disable

# Auth (Phase 5) — use a long random string in production
JWT_SECRET=dev-secret-change-me-in-prod
# JWT_TTL=24h

# Email notifications (optional). Without RESEND_API_KEY, alerts are logged only.
# RESEND_API_KEY=re_your_key_here
# NOTIFY_FROM=onboarding@resend.dev
